# ctest tirocinium.lorica_applied.compile_commands (cmake -P。Python に頼らない)。
# ビルドディレクトリの compile_commands.json を読み、Tirocinium 自身の全ての翻訳単位 (第三者・ビルドディレクトリの中・
# Lorica 自身を除く) のコンパイルコマンドに、Lorica が付けるはずの守りが入っていて、打ち消す設定が無いことを確かめる。
# 欠けている単位があれば、ファイル名と欠けたものを挙げて失敗する。見られない環境は "TR_LORICA_SKIP:" を出して skip
# (ctest の SKIP_REGULAR_EXPRESSION。黙って通さない)。
#
# 入力 (-D。tests/lorica_applied.cmake が渡す):
#   TR_CC_JSON           compile_commands.json のパス
#   TR_GENERATOR         CMake の generator (compile_commands.json を作らないものは skip)
#   TR_SOURCE_ROOT       対象とするソースの根 (native/)
#   TR_BINARY_ROOT       除外するビルドディレクトリ (FetchContent の _deps、Lorica の _lorica もここ)
#   TR_TOOLCHAIN         linux | msvc | unsupported
#   TR_TOOLCHAIN_REASON  unsupported のときの理由
#   TR_LORICA_INCLUDE    Lorica の include ディレクトリ
#   TR_LORICA_HEADER     強制 include されるはずの lorica/unsafe_api.hpp
#   TR_FORTIFY           この構成で Lorica が付ける _FORTIFY_SOURCE の値 (0 = 付けない構成 / 複数構成で決められない)
#   TR_CFI_FLAG          -fcf-protection=full (x86-64) | -mbranch-protection=standard (AArch64)
#   TR_EXTENDED_LIST     EXTENDED の対象のソース (絶対パス) を 1 行 1 つ並べたファイル (EXTENDED が無効なら空)
cmake_minimum_required(VERSION 3.24)

foreach(var TR_CC_JSON TR_GENERATOR TR_SOURCE_ROOT TR_BINARY_ROOT TR_TOOLCHAIN TR_LORICA_INCLUDE TR_LORICA_HEADER
            TR_FORTIFY TR_EXTENDED_LIST)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "lorica_compile_commands_check: -D${var}=... is required")
  endif()
endforeach()

if(TR_TOOLCHAIN STREQUAL "unsupported")
  message("TR_LORICA_SKIP: Lorica does not harden this toolchain/platform (${TR_TOOLCHAIN_REASON}); the build has no Lorica protection to check")
  return()
endif()
if(NOT EXISTS "${TR_CC_JSON}")
  if(TR_GENERATOR MATCHES "^(Visual Studio|Xcode)")
    message("TR_LORICA_SKIP: the ${TR_GENERATOR} generator writes no compile_commands.json, so the compile commands cannot be checked here (use Ninja)")
    return()
  endif()
  message(FATAL_ERROR "compile_commands.json is missing: ${TR_CC_JSON} (CMAKE_EXPORT_COMPILE_COMMANDS must be ON)")
endif()

function(tr_norm out path)
  cmake_path(NORMAL_PATH path)
  set(${out} "${path}" PARENT_SCOPE)
endfunction()
tr_norm(source_root "${TR_SOURCE_ROOT}/")
tr_norm(binary_root "${TR_BINARY_ROOT}/")
tr_norm(lorica_include "${TR_LORICA_INCLUDE}")
tr_norm(lorica_header "${TR_LORICA_HEADER}")

file(STRINGS "${TR_EXTENDED_LIST}" extended_sources)
set(extended_norm "")
foreach(src IN LISTS extended_sources)
  tr_norm(src "${src}")
  list(APPEND extended_norm "${src}")
endforeach()

# 1 つのコマンドの中に字句 (前後が空白) として token があるか。
function(tr_has_token out command token)
  string(FIND " ${command} " " ${token} " pos)
  if(pos EQUAL -1)
    set(${out} FALSE PARENT_SCOPE)
  else()
    set(${out} TRUE PARENT_SCOPE)
  endif()
endfunction()

function(tr_has_any out command)
  foreach(token IN LISTS ARGN)
    tr_has_token(found "${command}" "${token}")
    if(found)
      set(${out} TRUE PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} FALSE PARENT_SCOPE)
endfunction()

file(READ "${TR_CC_JSON}" json)
string(JSON count LENGTH "${json}")
set(checked 0)
set(checked_extended 0)
set(failures "")
set(seen_extended "")
math(EXPR last "${count} - 1")
foreach(i RANGE 0 ${last})
  string(JSON file GET "${json}" ${i} file)
  string(JSON dir GET "${json}" ${i} directory)
  if(NOT IS_ABSOLUTE "${file}")
    set(file "${dir}/${file}")
  endif()
  tr_norm(file "${file}")
  string(FIND "${file}" "${source_root}" in_source)
  string(FIND "${file}" "${binary_root}" in_binary)
  if(NOT in_source EQUAL 0 OR in_binary EQUAL 0)
    continue()  # 第三者・生成物・Lorica 自身 (どれも Tirocinium の根の外か、ビルドディレクトリの中)
  endif()
  string(JSON command ERROR_VARIABLE no_command GET "${json}" ${i} command)
  if(no_command)
    # "arguments" 形式 (配列) のとき: 空白でつなぐ。
    string(JSON nargs LENGTH "${json}" ${i} arguments)
    set(command "")
    math(EXPR nlast "${nargs} - 1")
    foreach(j RANGE 0 ${nlast})
      string(JSON arg GET "${json}" ${i} arguments ${j})
      string(APPEND command " ${arg}")
    endforeach()
  endif()
  string(REPLACE "\"" "" command "${command}")  # -include "<path>" と -include <path> を同じに扱う
  math(EXPR checked "${checked} + 1")

  set(is_c FALSE)
  if(file MATCHES "\\.c$")
    set(is_c TRUE)  # C の単位: C++ 専用のもの (標準ライブラリの検査・強制 include) は見ない
  endif()
  list(FIND extended_norm "${file}" ext_index)
  set(missing "")
  set(forbidden "")

  if(TR_TOOLCHAIN STREQUAL "linux")
    set(required -fstack-protector-strong -fstack-clash-protection ${TR_CFI_FLAG})
    if(NOT is_c)
      list(APPEND required -D_GLIBCXX_ASSERTIONS -Werror=deprecated-declarations "-include ${lorica_header}")
      if(ext_index EQUAL -1)
        list(APPEND required -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST)
      else()
        list(APPEND required -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE)
      endif()
    endif()
    if(NOT ext_index EQUAL -1)
      list(APPEND required -ftrivial-auto-var-init=zero)
    endif()
    if(NOT TR_FORTIFY EQUAL 0)
      list(APPEND required -U_FORTIFY_SOURCE "-D_FORTIFY_SOURCE=${TR_FORTIFY}")
    endif()
    foreach(flag IN LISTS required)
      tr_has_token(found "${command}" "${flag}")
      if(NOT found)
        list(APPEND missing "${flag}")
      endif()
    endforeach()
    tr_has_any(pic "${command}" -fPIE -fPIC -fpie -fpic)
    if(NOT pic)
      list(APPEND missing "-fPIE/-fPIC")
    endif()
    if(NOT is_c)
      tr_has_any(inc "${command}" "-I${lorica_include}" "-I ${lorica_include}" "-isystem ${lorica_include}"
                 "-isystem${lorica_include}")
      if(NOT inc)
        list(APPEND missing "-I${lorica_include}")
      endif()
    endif()
    # 打ち消す設定。_FORTIFY_SOURCE は最後に効く値を見る (Lorica 自身の -U/-D の後に別の値を足していないか)。
    foreach(flag -fno-stack-protector -fstack-protector -fno-stack-clash-protection -fcf-protection=none
                 -fcf-protection=return -fcf-protection=branch -mbranch-protection=none -D_FORTIFY_SOURCE=0
                 -U_GLIBCXX_ASSERTIONS -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_NONE
                 -Wno-error=deprecated-declarations
                 -Wno-deprecated-declarations -Wno-error -ftrivial-auto-var-init=uninitialized -fno-pie -fno-PIE
                 -fno-pic -fno-PIC)
      tr_has_token(found "${command}" "${flag}")
      if(found)
        list(APPEND forbidden "${flag}")
      endif()
    endforeach()
    string(REGEX MATCHALL "-D_FORTIFY_SOURCE=[0-9]+" fortify_defs " ${command} ")
    if(fortify_defs AND NOT TR_FORTIFY EQUAL 0)
      list(GET fortify_defs -1 fortify_last)
      if(NOT fortify_last STREQUAL "-D_FORTIFY_SOURCE=${TR_FORTIFY}")
        list(APPEND forbidden "${fortify_last} (last, overrides Lorica's ${TR_FORTIFY})")
      endif()
    endif()
    string(REGEX MATCHALL "-ftrivial-auto-var-init=[a-z]+" init_flags " ${command} ")
    if(NOT ext_index EQUAL -1 AND init_flags)
      list(GET init_flags -1 init_last)
      if(NOT init_last STREQUAL "-ftrivial-auto-var-init=zero")
        list(APPEND forbidden "${init_last} (last, overrides EXTENDED)")
      endif()
    endif()
  elseif(TR_TOOLCHAIN STREQUAL "msvc")
    # MSVC の枝 (LoricaHardening.cmake の _lorica_apply_baseline / _lorica_apply_extended / /we4996)。
    # クラウドの Linux では実行していない。
    foreach(flag GS sdl guard:cf)
      tr_has_any(found "${command}" "/${flag}" "-${flag}")
      if(NOT found)
        list(APPEND missing "/${flag}")
      endif()
    endforeach()
    if(NOT is_c)
      tr_has_any(found "${command}" /we4996 -we4996)
      if(NOT found)
        list(APPEND missing "/we4996")
      endif()
      if(NOT ext_index EQUAL -1)
        foreach(def _MSVC_STL_HARDENING=1 _MSVC_STL_DESTRUCTOR_TOMBSTONES=1)
          tr_has_any(found "${command}" "/D${def}" "-D${def}")
          if(NOT found)
            list(APPEND missing "/D${def}")
          endif()
        endforeach()
      endif()
    endif()
    foreach(flag GS- sdl- guard:cf- wd4996)
      tr_has_any(found "${command}" "/${flag}" "-${flag}")
      if(found)
        list(APPEND forbidden "/${flag}")
      endif()
    endforeach()
  else()
    message(FATAL_ERROR "unknown TR_TOOLCHAIN '${TR_TOOLCHAIN}'")
  endif()

  if(NOT ext_index EQUAL -1)
    math(EXPR checked_extended "${checked_extended} + 1")
    list(APPEND seen_extended "${file}")
  endif()
  if(missing OR forbidden)
    string(REPLACE ";" ", " missing "${missing}")
    string(REPLACE ";" ", " forbidden "${forbidden}")
    string(APPEND failures "\n  ${file}")
    if(missing)
      string(APPEND failures "\n      missing:   ${missing}")
    endif()
    if(forbidden)
      string(APPEND failures "\n      overrides: ${forbidden}")
    endif()
  endif()
endforeach()

# EXTENDED の対象のソースが compile_commands.json に全部あること (対象の一覧と実際のビルドがずれていないこと)。
foreach(src IN LISTS extended_norm)
  list(FIND seen_extended "${src}" pos)
  if(pos EQUAL -1)
    string(APPEND failures "\n  ${src}\n      missing:   no compile command for this EXTENDED source")
  endif()
endforeach()

if(checked EQUAL 0)
  message(FATAL_ERROR "no Tirocinium translation unit under ${source_root} found in ${TR_CC_JSON}")
endif()
if(failures)
  message(FATAL_ERROR "Lorica is not fully applied to these translation units:${failures}")
endif()
list(LENGTH extended_norm n_extended)
message("ok: ${checked} Tirocinium translation units carry Lorica's flags (${checked_extended} EXTENDED of ${n_extended} expected), toolchain ${TR_TOOLCHAIN}, _FORTIFY_SOURCE=${TR_FORTIFY}")
